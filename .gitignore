# Dependencies
node_modules/
.pnpm-store/
__pycache__/
*.py[cod]

# Build output
.next/
out/
dist/
build/

# Tauri (paths under frontend/ — patterns containing '/' are root-anchored).
frontend/src-tauri/target/
frontend/src-tauri/gen/schemas/
**/src-tauri/target/
**/src-tauri/gen/schemas/

# Sidecar binaries — built per-target by scripts/build-sdcpp-*.{sh,ps1}.
# Never commit these (large, target-specific). CI produces them per build.
frontend/src-tauri/binaries/sd-*
frontend/src-tauri/binaries/*.dll
frontend/src-tauri/binaries/sdcpp-runtime-manifest.json
!frontend/src-tauri/binaries/.gitkeep

# Vendored sd.cpp build artifacts
vendor/sdcpp-build-*/

# Local downloads / models (never commit large blobs)
models/
downloads/
*.gguf
*.bin
*.safetensors

# Env / secrets
.env
.env.local
.env*.local
*.pem
*.key
*.p8
*.p12
*.pfx
*.PFX
*.provisionprofile
frontend/src-tauri/Entitlements.appstore.plist
frontend/src-tauri/tauri.windows.signing.conf.json

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp

# Logs
*.log
npm-debug.log*
yarn-debug.log*

# Private orchestration / AI assistant traces — never push
CLAUDE.md
AGENTS.md
GEMINI.md
.cursor/
.cursorrules
.aider*
.claude/
.claude-flow/
.windsurf/
plan/.private/
.copilot/

# TypeScript
*.tsbuildinfo
next-env.d.ts
